<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" />
    <link rel="stylesheet" href="@Assets["css/petcare.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoDePagina" />
</head>

<body>
    <Routes @rendermode="ModoDePagina" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // El inicio de sesión se dibuja en el servidor sin interactividad (necesita escribir la cookie);
    // el resto de pantallas son interactivas (Blazor Server).
    private IComponentRenderMode? ModoDePagina =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
